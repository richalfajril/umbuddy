# Umbuddy V1 environment template.
# Copy to .env.local for local development. Never commit real secrets.

# App URL used by NextAuth callbacks and email links.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-random-32-byte-secret"

# Supabase Postgres pooled connection for runtime API.
# Use Supavisor pooled URL on port 6543.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# Upstash Redis Free for auth/API rate limits.
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-token"

# Google OAuth.
# Leave empty to disable GoogleProvider; /api/v1/public/auth-status returns NOT_VERIFIED.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Free for verification/reset emails.
RESEND_API_KEY=""
EMAIL_FROM="Umbuddy <onboarding@resend.dev>"

# Internal job endpoint protection.
JOB_RUNNER_SECRET="replace-with-random-job-secret"

# Admin seed untuk membuat akun backoffice pertama.
# Jalankan: npm run seed:admin
ADMIN_SEED_EMAIL="admin@umbuddy.id"
ADMIN_SEED_PASSWORD="Replace-With-Strong-Admin-Passw0rd!"
ADMIN_SEED_ROLE="SUPER_ADMIN"
